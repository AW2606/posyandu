# Salin menjadi .env lalu isi dari Supabase > Project Settings > API.
# Dengan ini, semua HP yang membuka aplikasi otomatis terhubung ke server yang sama,
# jadi kader cukup membuka alamat aplikasi lalu masuk. Pakai kunci anon public, BUKAN service_role.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
